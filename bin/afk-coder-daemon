#!/usr/bin/env node
const path = require('path');
const fs = require('fs');

// Try to find dist in several locations
const possiblePaths = [
  path.join(__dirname, '../dist/daemon/index.js'), // Development
  '/usr/local/lib/afk-coder/dist/daemon/index.js',  // Installed
  '/usr/lib/afk-coder/dist/daemon/index.js'         // Alternative installed
];

let found = false;
for (const p of possiblePaths) {
  if (fs.existsSync(p)) {
    require(p);
    found = true;
    break;
  }
}

if (!found) {
  console.error("Could not find afk-coder-daemon distribution files.");
  process.exit(1);
}
